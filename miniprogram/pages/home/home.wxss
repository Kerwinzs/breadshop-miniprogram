@import '../../app.wxss';
.home-location{display:flex;align-items:center;gap:14rpx;padding:6rpx 4rpx 24rpx}.location-mark{color:#b85e6d;font-size:38rpx}.location-name{display:block;font-family:"Iowan Old Style","Baskerville","Songti SC",Georgia,serif;font-size:31rpx;font-weight:700}.location-arrow{margin-left:auto;color:#718083;font-size:38rpx}.home-hero{position:relative;overflow:hidden;padding:42rpx 34rpx 38rpx;border-radius:36rpx;background:linear-gradient(140deg,#fffcf4 2%,#ffe0e6 58%,#ffbcbd);box-shadow:0 18rpx 42rpx rgba(52,78,80,.14)}.home-hero::after{content:"";position:absolute;right:-55rpx;bottom:-68rpx;width:210rpx;height:210rpx;border:24rpx solid rgba(255,252,244,.55);border-radius:50%}.hero-kicker,.scene-eyebrow{display:block;color:#80555d;font-size:20rpx;font-weight:700;letter-spacing:2rpx}.hero-title{display:block;position:relative;z-index:1;margin:18rpx 0;font-family:"Iowan Old Style","Baskerville","Songti SC",Georgia,serif;font-size:60rpx;font-weight:700;line-height:1.04;letter-spacing:-.07em}.hero-copy{display:block;position:relative;z-index:1;width:78%;color:#596d70;font-size:25rpx;line-height:1.55}.hero-pill{position:relative;z-index:1;margin-top:25rpx}.scene-grid,.recommend-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.scene-card{position:relative;min-height:224rpx;padding:26rpx 23rpx;border:2rpx solid #c7dce5;border-radius:28rpx;box-shadow:0 12rpx 25rpx rgba(52,78,80,.08)}.pickup-scene{background:#fffcf4}.delivery-scene{background:#eaf5f9}.scene-card .mode-title{display:block;margin:14rpx 0 8rpx;font-size:36rpx}.scene-arrow{position:absolute;right:23rpx;bottom:22rpx;color:#c96f78;font-size:34rpx}.recommend-card{min-width:0;padding:0 4rpx}.recommend-art{height:192rpx;margin-bottom:17rpx}.recommend-card .product-name{display:block;font-size:29rpx}.recommend-card .price{display:block;margin-top:11rpx}
