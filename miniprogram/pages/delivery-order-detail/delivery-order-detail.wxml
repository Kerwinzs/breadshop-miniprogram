<view class="page fixed-space">
  <view class="page-heading"><text class="title">配送订单详情</text><button class="text-button back-button" bindtap="back">返回</button></view>
  <view wx:if="{{order}}">
    <view class="hero"><text class="pill">{{order.sceneLabel}}</text><view class="title" style="font-size:46rpx;margin-top:18rpx">{{order.orderStatus}}</view><text class="subtitle">{{order.address.contactName}} · {{order.address.phone}}</text><text class="subtitle">{{order.address.fullAddress}}</text></view>
    <view class="card section"><view class="row"><text class="product-name">支付状态</text><text>{{order.paymentLabel}}</text></view><view class="row"><text>在线应付（商品小计）</text><text class="price">{{order.payableAmount}}</text></view><text class="subtitle">{{order.deliveryMethod==='shipping'?'快递运费':'同城配送费'}}到付</text><text wx:if="{{order.canPay}}" class="subtitle">请在订单生成后15分钟内支付。</text><text wx:if="{{order.paymentExpired}}" class="subtitle">支付时限已过，订单已关闭或正在关闭。</text></view>
    <view class="card section"><text class="product-name">商品明细</text><view class="row" wx:for="{{order.items}}" wx:key="productId"><view><text>{{item.name}} · {{item.specName}} × {{item.quantity}}</text><text wx:if="{{item.shippingRequired}}" class="subtitle">拍前必读 · 固定 1 件</text></view><text>{{item.lineTotal}}</text></view><view class="row"><text>商品总额</text><text>{{order.subtotal}}</text></view><block wx:if="{{order.hasLegacyLocalFees}}"><view class="row"><text>保温包装费</text><text>{{order.insulation}}</text></view><view class="row"><text>配送费</text><text>{{order.transport}}</text></view></block><view wx:else class="row"><text>{{order.deliveryMethod==='shipping'?'快递运费':'同城配送费'}}</text><text>到付</text></view><view class="row"><text>合计</text><text class="price">{{order.total}}</text></view></view>
    <view class="card section"><text class="subtitle">订单号 {{order.id}}</text><text class="subtitle">配送方式：{{order.sceneLabel}}</text><text class="subtitle">下单时间 {{order.createdAt}}</text></view>
    <button wx:if="{{order.canPay}}" class="btn section" loading="{{paying}}" bindtap="pay">立即支付 · {{order.payableAmount}}</button><button wx:if="{{order.paymentStatus==='pending'}}" class="btn secondary section" loading="{{checkingPayment}}" bindtap="checkPayment">查询支付结果</button><button wx:if="{{canCancel}}" class="btn secondary section" bindtap="cancel">取消订单</button><button wx:if="{{canReorder}}" class="btn section" bindtap="reorder">再来一单</button>
  </view>
  <view wx:else class="notice">未找到该订单。</view>
</view>
