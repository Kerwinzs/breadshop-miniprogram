<view class="page fixed-space"><view class="page-heading"><text class="title">配送订单详情</text><button class="text-button back-button" bindtap="back">返回</button></view><view wx:if="{{order}}"><view class="hero"><text class="pill">{{order.sceneLabel}}</text><view class="title" style="font-size:46rpx;margin-top:18rpx">{{order.orderStatus}}</view><text class="subtitle">{{order.address.contactName}} · {{order.address.phone}}</text><text class="subtitle">{{order.address.fullAddress}}</text></view><view class="card section"><text class="product-name">商品明细</text><view class="row" wx:for="{{order.items}}" wx:key="productId"><text>{{item.name}} · {{item.specName}} × {{item.quantity}}</text><text>{{item.lineTotal}}</text></view><view class="row"><text>商品总额</text><text>{{order.subtotal}}</text></view><view class="row"><text>保温包装费</text><text>{{order.insulation}}</text></view><view class="row"><text>{{order.deliveryMethod==='shipping'?'邮费':'配送费'}}</text><text>{{order.transport}}</text></view><view class="row"><text>合计</text><text class="price">{{order.total}}</text></view></view><view class="card section"><text class="subtitle">订单号 {{order.id}}</text><text class="subtitle">配送方式：{{order.sceneLabel}}</text><text class="subtitle">下单时间 {{order.createdAt}}</text></view><button wx:if="{{canCancel}}" class="btn secondary section" bindtap="cancel">取消订单</button><button wx:if="{{canReorder}}" class="btn section" bindtap="reorder">再来一单</button></view><view wx:else class="notice">未找到该订单。</view></view>
