<view class="page with-fixed-action">
  <view class="products-head">
<view>
<text class="title">到店自取</text>
<text class="subtitle">为你保留刚出炉的风味</text>
</view>
<button class="scene-switch" bindtap="toDelivery">外卖/邮寄</button>
</view>
  <view class="store-card section" bindtap="toStores">
<text class="store-pin">⌖</text>
<view>
<text class="store-label">取货门店</text>
<text class="product-name">{{store?store.name:'请选择自取门店'}}</text>
<text class="subtitle">{{store?(store.address+' · '+(store.status==='open'?'营业中':'已打烊')):'选择门店后可确认下单'}}</text>
</view>
<text class="store-arrow">›</text>
</view>
  <scroll-view class="category-scroll section" scroll-x enable-flex>
<view class="categories">
<block wx:for="{{categories}}" wx:key="*this">
<button class="category {{activeCategory===item?'active':''}}" data-category="{{item}}" bindtap="selectCategory">{{item}}</button>
</block>
</view>
</scroll-view>
  <view wx:if="{{products.length}}" class="product-grid section">
<block wx:for="{{products}}" wx:key="id">
<view class="product-card {{item.unavailable?'sold-out':''}}" data-id="{{item.id}}" bindtap="goDetail">
<view class="art product-art {{item.artClass}}">
<image wx:if="{{item.primaryImageUrl}}" class="product-photo" src="{{item.primaryImageUrl}}" mode="aspectFill" />
<text wx:if="{{item.soldOut}}" class="sold-out-tag">已售罄</text>
<text wx:if="{{!item.soldOut && item.supportsPickup===false}}" class="sold-out-tag">暂不支持自取</text>
</view>
<text class="product-name">{{item.name}}</text>
<text class="subtitle">{{item.desc}}</text>
<view class="product-foot">
<text class="price">{{item.priceText}}</text>
<view wx:if="{{!item.unavailable}}" class="stepper" catchtap="stop">
<button data-id="{{item.id}}" catchtap="decrease">−</button>
<text>{{item.quantity}}</text>
<button data-id="{{item.id}}" catchtap="increase">+</button>
</view>
</view>
</view>
</block>
</view>
  <view wx:else class="empty-state section">
<text class="pill">商品分类</text>
<text class="empty-title">这类面包正在出炉。</text>
<text class="subtitle">换个分类看看，或稍后再来。</text>
</view>
  <view class="bar" bindtap="toCart">
<view class="bar-content">
<view class="bar-copy">
<text class="cart-count">自取购物车 · {{cartCount}} 件</text>
<text wx:if="{{cartCount}}" class="price">{{cartSubtotal}}</text>
<text wx:else>先选一份喜欢的面包</text>
</view>
<button class="btn">去购物车</button>
</view>
</view>
</view>
