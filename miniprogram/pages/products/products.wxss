@import '../../app.wxss';
.product-photo{position:absolute;inset:0;width:100%;height:100%;border-radius:inherit}
.products-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.products-head .subtitle{margin-top:10rpx}.scene-switch{margin:0;padding:14rpx 18rpx;border:2rpx solid #c7dce5;border-radius:999rpx;background:#fffcf4;color:#b85e6d;font-size:23rpx}.store-card{display:flex;align-items:center;gap:16rpx}.store-pin{color:#c96f78;font-size:38rpx}.store-label{display:block;color:#718083;font-size:21rpx}.store-card .product-name{display:block;margin:3rpx 0;font-size:31rpx}.store-arrow{margin-left:auto;color:#718083;font-size:38rpx}.category-scroll{width:calc(100% + 64rpx);margin-left:-32rpx;padding-left:32rpx}.categories{display:flex;gap:12rpx;padding-right:32rpx}.category{flex:none;margin:0;padding:15rpx 23rpx;border:0;border-radius:999rpx;background:#e7f3f8;color:#718083;font-size:24rpx;line-height:1}.category.active{background:#fffcf4;color:#344e50;box-shadow:0 6rpx 14rpx rgba(52,78,80,.1)}.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.product-card{min-width:0;padding:16rpx;border:2rpx solid #c7dce5;border-radius:28rpx;background:#fffcf4;box-shadow:0 12rpx 25rpx rgba(52,78,80,.08)}.product-art{height:196rpx;margin-bottom:18rpx}.product-card .product-name{display:block;font-size:29rpx}.product-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:8rpx;margin-top:14rpx}.product-foot .price{font-size:29rpx}.product-foot .stepper{gap:7rpx;padding:4rpx}.product-foot .stepper button{width:42rpx;height:42rpx;font-size:30rpx}.product-foot .stepper text{font-size:21rpx}.sold-out{opacity:.64}.sold-out-tag{position:absolute;top:14rpx;left:14rpx;padding:8rpx 12rpx;border-radius:999rpx;background:rgba(52,78,80,.75);color:#fffcf4;font-size:20rpx}.cart-count{color:#344e50!important;font-weight:700}
