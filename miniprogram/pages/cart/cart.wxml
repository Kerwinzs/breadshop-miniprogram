<view class="page with-fixed-action">
  <view class="cart-head"><view><text class="title">自取购物车</text><text class="subtitle">只包含到店自取商品</text></view><button class="text-button" bindtap="clear">清空</button></view>
  <view class="store-summary section" bindtap="toStores"><view><text class="scene-tag">到店自取</text><text class="product-name store-name">{{store?store.name:'请选择自取门店'}}</text><text class="subtitle">{{store?(store.address+' · '+store.businessHours):'选择门店后可确认下单'}}</text><text wx:if="{{storeMessage}}" class="subtitle">{{storeMessage}}</text></view><text class="store-arrow">›</text></view>
  <view wx:if="{{unavailableMessage}}" class="notice section">{{unavailableMessage}}</view>
  <view wx:if="{{empty}}" class="empty-state section"><text class="pill">自取购物车</text><text class="empty-title">先挑一份刚出炉的面包。</text><text class="subtitle">选好后，我们会为你保留取餐时间。</text><button class="btn" bindtap="toProducts">去选商品</button></view>
  <block wx:else><view class="cart-list section"><block wx:for="{{items}}" wx:key="id"><view class="cart-item"><view class="art cart-art {{item.artClass}}"></view><view class="cart-info"><text class="product-name">{{item.name}}</text><text class="subtitle">{{item.specName}} · 到店自取</text><view class="cart-bottom"><text class="price">{{item.unitPrice}}</text><view class="stepper"><button data-id="{{item.id}}" data-delta="-1" bindtap="change">−</button><text>{{item.quantity}}</text><button data-id="{{item.id}}" data-delta="1" bindtap="change">+</button></view></view></view></view></block></view>
  <view class="card section fee-card"><view class="fee-row"><text>商品小计</text><text>{{subtotal}}</text></view><view class="fee-row fee-total"><text>合计</text><text class="price">{{subtotal}}</text></view><text class="subtitle fee-note">到店自取不收取保温包装费、配送费或邮费</text></view></block>
  <view class="action-bar"><button class="btn" disabled="{{empty || unavailableItems.length}}" bindtap="checkout">去结算 <text wx:if="{{!empty}}">· {{subtotal}}</text></button></view>
</view>
