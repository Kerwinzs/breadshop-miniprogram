@import '../../app.wxss';
.cart-head{display:flex;align-items:flex-start;justify-content:space-between}.store-summary{display:flex;align-items:center;justify-content:space-between;padding:26rpx 28rpx;border-radius:28rpx;background:#eaf5f9;border:2rpx solid #c7dce5}.store-name{display:block;margin:13rpx 0 4rpx;font-size:32rpx}.store-arrow{color:#718083;font-size:40rpx}.cart-list{display:grid;gap:18rpx}.cart-item{display:flex;gap:20rpx;padding:18rpx;border:2rpx solid #c7dce5;border-radius:28rpx;background:#fffcf4;box-shadow:0 10rpx 22rpx rgba(52,78,80,.07)}.cart-art{flex:none;width:156rpx;height:156rpx}.cart-info{display:flex;flex:1;min-width:0;flex-direction:column;justify-content:space-between}.cart-info .product-name{font-size:30rpx}.cart-bottom{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:15rpx}.cart-bottom .stepper{gap:8rpx;padding:4rpx}.cart-bottom .stepper button{width:42rpx;height:42rpx;font-size:30rpx}.cart-bottom .stepper text{font-size:21rpx}.fee-card{padding:25rpx 28rpx}.fee-row{display:flex;align-items:center;justify-content:space-between;margin:12rpx 0;color:#596d70;font-size:26rpx}.fee-total{margin-top:22rpx;padding-top:22rpx;border-top:2rpx solid #dcebf0;color:#344e50;font-weight:700}.fee-note{margin-top:14rpx}
