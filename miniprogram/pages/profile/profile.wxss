@import '../../app.wxss';

.profile-page { padding-top: 0; }
.profile-hero { position: relative; display: flex; align-items: center; gap: 18rpx; min-height: 226rpx; margin: 0 -32rpx; padding: 36rpx 38rpx; overflow: hidden; border-radius: 0 0 38rpx 38rpx; background: linear-gradient(135deg, #fffcf4 0%, #ffe0e6 58%, #ffbcbd 100%); box-shadow: 0 15rpx 32rpx rgba(52, 78, 80, .12); }
.avatar { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; flex: none; width: 100rpx; height: 100rpx; border: 6rpx solid rgba(255, 252, 244, .72); border-radius: 32rpx; background: #d3e8f4; color: #b85e6d; font-family: "Iowan Old Style", "Baskerville", "Songti SC", Georgia, serif; font-size: 46rpx; font-weight: 700; box-shadow: 0 10rpx 22rpx rgba(52,78,80,.13); }
.profile-copy { position: relative; z-index: 1; min-width: 0; }.profile-kicker { display: block; color: #80555d; font-size: 18rpx; font-weight: 700; letter-spacing: 1.5rpx; }.profile-name { display: block; margin: 9rpx 0 6rpx; font-family: "Iowan Old Style", "Baskerville", "Songti SC", Georgia, serif; font-size: 45rpx; font-weight: 700; letter-spacing: -.06em; }
.hero-bread { position: absolute; right: -42rpx; bottom: -58rpx; width: 210rpx; height: 210rpx; border: 19rpx solid rgba(255,252,244,.55); border-radius: 50%; transform: rotate(-12deg); }.hero-bread view { width: 98rpx; height: 57rpx; margin: 55rpx 0 0 21rpx; border-radius: 55% 45% 48% 52%; background: #ffbcbd; box-shadow: inset -12rpx -8rpx 0 rgba(201,111,120,.22); }
.order-shortcut { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; padding: 28rpx; border: 2rpx solid #c7dce5; border-radius: 29rpx; background: #fffcf4; box-shadow: 0 14rpx 30rpx rgba(52,78,80,.09); }.shortcut-title { display: block; margin: 13rpx 0 5rpx; color: #344e50; font-family: "Iowan Old Style", "Baskerville", "Songti SC", Georgia, serif; font-size: 32rpx; font-weight: 700; }.shortcut-arrow,.menu-arrow { color: #b85e6d; font-size: 42rpx; font-weight: 300; }
.service-note { color: #718083; font-size: 20rpx; }.profile-menu { display: grid; gap: 16rpx; }.menu-item { display: flex; align-items: center; gap: 18rpx; min-height: 122rpx; padding: 20rpx; border: 2rpx solid #c7dce5; border-radius: 27rpx; background: rgba(255,252,244,.94); box-shadow: 0 10rpx 24rpx rgba(52,78,80,.07); }.menu-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 68rpx; height: 68rpx; border-radius: 22rpx; color: #80555d; font-size: 33rpx; font-weight: 700; }.order-icon { background: #ffe0e6; }.address-icon { background: #e7f3f8; }.store-icon { background: #ffe8e9; }.menu-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 7rpx; }.menu-copy text:first-child { color: #344e50; font-family: "Iowan Old Style", "Baskerville", "Songti SC", Georgia, serif; font-size: 30rpx; font-weight: 700; }.menu-copy text:last-child { color: #718083; font-size: 22rpx; }.profile-note { display: flex; flex-direction: column; gap: 8rpx; margin-top: 32rpx; padding: 24rpx 27rpx; border-radius: 26rpx; background: #e7f3f8; color: #607478; }.profile-note text:first-child { color: #344e50; font-size: 23rpx; font-weight: 700; }.profile-note text:last-child { font-size: 22rpx; line-height: 1.55; }
.auth-card { margin-top: 20rpx; }
.auth-retry { margin-top: 16rpx; padding: 0; }
