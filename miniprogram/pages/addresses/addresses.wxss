@import '../../app.wxss';
.page-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.back-button{padding:12rpx 0;color:#718083}.address-card .subtitle{margin-top:9rpx}.address-actions{display:flex;align-items:center;justify-content:flex-end;gap:16rpx;margin-top:19rpx}.address-action{box-sizing:border-box;margin:0;padding:10rpx 17rpx;border:2rpx solid #c7dce5;border-radius:999rpx;background:#e7f3f8;color:#607478;font-size:22rpx;line-height:1}.address-action.danger{background:#fffcf4;color:#b85e6d}.page>.btn{width:100%}.address-form input,.address-form picker{box-sizing:border-box;display:block;width:100%;max-width:100%}.address-form input{height:76rpx;margin-top:18rpx;padding:0 22rpx;border:2rpx solid #c7dce5;border-radius:18rpx;background:#fffefa;color:#344e50;font-size:25rpx}.region-field{width:100%;max-width:100%;margin-top:18rpx}.field-label{display:block;margin:0 0 10rpx 4rpx;color:#718083;font-size:23rpx}.region-picker{box-sizing:border-box;display:flex;align-items:center;width:100%;min-width:0;min-height:76rpx;padding:0 22rpx;border:2rpx solid #c7dce5;border-radius:18rpx;background:#fffefa}.region-value{flex:1;min-width:0;overflow:hidden;color:#344e50;font-size:25rpx;white-space:nowrap;text-overflow:ellipsis}.region-value.unknown{color:#b85e6d}.region-hint{flex-shrink:0;margin-left:14rpx;color:#718083;font-size:21rpx;white-space:nowrap}.region-arrow{flex-shrink:0;margin-left:12rpx;color:#b85e6d;font-size:34rpx;line-height:1}.region-warning{display:block;margin:10rpx 4rpx 0;color:#b85e6d;font-size:22rpx;line-height:1.45}.address-actions .btn{box-sizing:border-box;min-height:76rpx;padding:0 30rpx}
