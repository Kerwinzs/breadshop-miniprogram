<view class="page"><view class="page-heading"><text class="title">配送地址</text><button class="text-button back-button" bindtap="back">返回</button></view><view wx:if="{{!addresses.length && !editing}}" class="notice">暂未设置地址。新增后可作为外卖/邮寄的收货地址。</view><view wx:if="{{!editing}}" class="card address-card section" wx:for="{{addresses}}" wx:key="id"><view class="row"><text class="product-name">{{item.contactName}} · {{item.phone}}</text><text wx:if="{{item.isDefault}}" class="pill">默认</text></view><text class="subtitle">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text><view class="address-actions"><button class="address-action" data-id="{{item.id}}" bindtap="choose">选择</button><button class="address-action" data-id="{{item.id}}" bindtap="edit">编辑</button><button class="address-action danger" data-id="{{item.id}}" bindtap="remove">删除</button></view></view><button wx:if="{{!editing}}" class="btn section" bindtap="add">新增地址</button><view wx:if="{{editing}}" class="card section address-form"><text class="product-name">{{form.id?'编辑地址':'新增地址'}}</text><input placeholder="联系人" value="{{form.contactName}}" data-field="contactName" bindinput="input"/><input type="number" maxlength="11" placeholder="手机号" value="{{form.phone}}" data-field="phone" bindinput="input"/><view class="region-field"><text class="field-label">所在地区</text><picker mode="multiSelector" range="{{regionRange}}" value="{{regionValue}}" bindchange="regionChange" bindcolumnchange="regionColumnChange" bindcancel="regionCancel"><view class="region-picker"><text class="region-value {{regionKnown?'':'unknown'}}">{{regionText}}</text><text class="region-hint">点击选择省、市、区县</text><text class="region-arrow">›</text></view></picker><text wx:if="{{!regionKnown}}" class="region-warning">当前地址地区暂不在可选范围内，请重新选择后保存</text></view><input placeholder="详细地址" value="{{form.detail}}" data-field="detail" bindinput="input"/><input placeholder="邮政编码（可选）" value="{{form.postalCode}}" data-field="postalCode" bindinput="input"/><view class="address-actions"><button class="address-action" bindtap="cancelEdit">取消</button><button class="btn" bindtap="save">保存地址</button></view></view></view>
