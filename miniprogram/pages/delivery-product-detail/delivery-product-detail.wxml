<view class="page fixed-space"><view class="hero" style="height:420rpx"><view class="art" style="height:300rpx;margin:0"></view></view><view class="section"><text class="subtitle">外卖/邮寄 · 另计保温包装费及配送费/邮费</text><view class="title" style="margin:14rpx 0">{{product.name}}</view><text class="subtitle">{{product.desc}}</text><view class="row"><text class="price">{{price}}</text><text class="subtitle">已售 128</text></view></view><view class="card section"><text class="product-name">规格选择</text><view class="tabs"><block wx:for="{{specs}}" wx:key="id"><button class="tab {{selectedSpec.id===item.id?'active':''}}" data-index="{{index}}" bindtap="selectSpec">{{item.name}}</button></block></view></view><view class="bar row"><button class="tab" bindtap="cart">购物车 {{cartCount}}</button><view class="stepper"><button bindtap="decrease">−</button><text>{{quantity}}</text><button bindtap="increase">+</button></view><button class="btn" style="flex:1" bindtap="add">加入配送购物车</button></view></view>
