<view class="page fixed-space">
  <view class="row"><text class="title">配送购物车</text><button class="text-button" bindtap="back">返回</button></view>
  <view class="delivery-tabs"><button class="delivery-tab {{method==='local'?'active':''}}" data-method="local" bindtap="method">同城外卖</button><button class="delivery-tab {{method==='shipping'?'active':''}}" data-method="shipping" bindtap="method">快递邮寄</button></view>
  <view class="card section" bindtap="address"><text class="product-name">{{address?(address.contactName+' · '+address.detail):'请选择收货地址'}}</text><text class="subtitle">{{addressHint}} · 点击修改收货地址</text></view>
  <view wx:if="{{message}}" class="notice">{{message}}</view>
  <view wx:if="{{unavailableMessage}}" class="notice section">{{unavailableMessage}}</view>
  <view wx:if="{{empty}}" class="notice section">配送购物车为空。</view>
  <view wx:if="{{!empty && !hasRegularItems}}" class="notice section">请至少选择一件普通商品后再结算。</view>
  <block wx:if="{{!empty}}">
    <view class="card section" wx:for="{{items}}" wx:key="id"><text class="product-name">{{item.name}}</text><text class="subtitle">{{item.shippingRequired?'拍前必读':(item.specName || '标准规格')}}</text><view class="row"><view wx:if="{{!item.shippingRequired}}" class="stepper"><button data-id="{{item.id}}" data-delta="-1" bindtap="change">−</button><text>{{item.quantity}}</text><button data-id="{{item.id}}" data-delta="1" bindtap="change">+</button></view><text wx:else class="pill">固定 1 件 · 不可删除</text><text class="price">{{item.unitPrice}}</text></view></view>
    <view class="card section"><view class="row"><text>商品总额（含打包商品）</text><text>{{subtotal}}</text></view><view class="row"><text>{{method==='shipping'?'快递运费':'同城配送费'}}</text><text class="subtitle">到付</text></view><view class="row"><text>线上订单合计</text><text class="price">{{total}}</text></view></view>
  </block>
  <view class="bar"><button class="btn" disabled="{{empty || !hasRegularItems || unavailableItems.length || status!=='ready'}}" style="width:100%" bindtap="checkout">去结算</button></view>
</view>
