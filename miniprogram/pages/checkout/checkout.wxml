<view class="page fixed-space">
  <view class="title">{{method==='shipping'?'快递邮寄':'同城外卖'}}订单</view>
  <view class="card section" bindtap="addressPage"><text class="product-name">{{address?(address.contactName+' · '+address.phone):'收货地址待填写'}}</text><text class="subtitle">{{address?(address.province+address.city+address.district+address.detail):'点击填写联系人、电话和详细地址'}}</text></view>
  <view class="delivery-tabs"><button class="delivery-tab {{method==='local'?'active':''}}" data-method="local" bindtap="method">同城外卖</button><button class="delivery-tab {{method==='shipping'?'active':''}}" data-method="shipping" bindtap="method">快递邮寄</button></view>
  <view wx:if="{{message}}" class="notice">{{message}}</view>
  <view wx:if="{{unavailableMessage}}" class="notice section">{{unavailableMessage}}</view>
  <view wx:if="{{items.length && !hasRegularItems}}" class="notice section">请至少选择一件普通商品后再下单。</view>
  <view class="card"><text class="product-name">商品明细</text><view class="row" wx:for="{{items}}" wx:key="id"><view><text>{{item.name}} · {{item.specName}} × {{item.quantity}}</text><text wx:if="{{item.shippingRequired}}" class="subtitle">拍前必读 · 固定 1 件</text></view><text>{{item.lineTotal}}</text></view></view>
  <view class="card section"><view class="row"><text>商品总额（含打包商品）</text><text>{{subtotal}}</text></view><view class="row"><text>{{method==='shipping'?'快递运费':'同城配送费'}}</text><text class="subtitle">到付</text></view><view class="row"><text>线上订单合计</text><text class="price">{{total}}</text></view></view>
  <view class="notice section">微信支付仅收取商品小计，配送费或快递运费到付。订单生成后15分钟内完成支付。</view>
  <view class="bar"><button class="btn" loading="{{submitting}}" disabled="{{submitting || !hasRegularItems || unavailableItems.length || status!=='ready'}}" style="width:100%" bindtap="submit">提交订单并支付</button></view>
</view>
