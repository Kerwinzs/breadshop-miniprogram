<view class="page fixed-space"><view class="title">{{method==='shipping'?'快递邮寄':'同城外卖'}}订单</view><view class="card section" bindtap="addressPage"><text class="product-name">{{address?(address.contactName+' · '+address.phone):'收货地址待填写'}}</text><text class="subtitle">{{address?(address.province+address.city+address.district+address.detail):'点击填写联系人、电话和详细地址'}}</text></view><view class="delivery-tabs"><button class="delivery-tab {{method==='local'?'active':''}}" data-method="local" bindtap="method">同城外卖</button><button class="delivery-tab {{method==='shipping'?'active':''}}" data-method="shipping" bindtap="method">快递邮寄</button></view><view wx:if="{{message}}" class="notice">{{message}}</view><view wx:if="{{unavailableMessage}}" class="notice section">{{unavailableMessage}}</view><view class="card"><text class="product-name">商品明细</text><view class="row" wx:for="{{items}}" wx:key="id"><text>{{item.name}} · {{item.specName}} × {{item.quantity}}</text><text>{{item.lineTotal}}</text></view></view><view class="card section"><view class="row"><text>商品总额</text><text>{{subtotal}}</text></view><view class="row"><text>保温包装费</text><text>{{insulation}}</text></view><view class="row"><text>{{transportLabel}}</text><text class="subtitle">{{transport}}</text></view><view class="row"><text>合计</text><text class="price">{{total}}</text></view></view><view class="bar"><button class="btn" loading="{{submitting}}" disabled="{{submitting || unavailableItems.length || status!=='ready'}}" style="width:100%" bindtap="submit">确认下单</button></view></view>
