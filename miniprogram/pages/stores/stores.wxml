<view class="page"><view class="page-heading"><text class="title">自取门店</text><button class="text-button back-button" bindtap="back">返回</button></view><view class="store-list"><block wx:for="{{stores}}" wx:key="id"><view class="card store-card"><view class="row"><text class="product-name">{{item.name}}</text><text class="pill">{{item.status==='open'?'营业中':'已打烊'}}</text></view><text class="subtitle">{{item.address}} · 距你 {{item.distanceText}}</text><text wx:if="{{item.status!=='open'}}" class="subtitle">当前门店已关闭，营业时间 {{item.businessHours}}</text><button class="btn {{selectedId===item.id?'btn-secondary':''}} store-select" data-id="{{item.id}}" bindtap="choose">{{selectedId===item.id?'当前门店':'选择此门店'}}</button></view></block></view></view>
