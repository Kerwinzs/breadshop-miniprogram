<view class="page tab-page"><view class="title">订单</view><view class="order-filters"><button class="order-filter {{filter==='all'?'active':''}}" data-filter="all" bindtap="filter">全部</button><button class="order-filter {{filter==='pickup'?'active':''}}" data-filter="pickup" bindtap="filter">到店自取</button><button class="order-filter {{filter==='delivery'?'active':''}}" data-filter="delivery" bindtap="filter">外卖/邮寄</button></view><view wx:if="{{!orders.length}}" class="notice">暂无符合条件的订单。</view><view class="list"><view class="card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><view class="row"><text class="pill">{{item.scene}}</text><text>{{item.orderStatus}}</text></view><text class="product-name">{{item.itemsText}}</text><text class="subtitle">{{item.purchaseScene==='delivery'?'配送订单':item.pickupInfo}}</text><view class="row"><text class="subtitle">订单号 {{item.id}}</text><text class="price">{{item.total}}</text></view></view></view></view>
