<view class="page with-fixed-action">
  <view class="delivery-head"><view><text class="title">外卖/邮寄</text><text class="subtitle">配送方式可在结算前切换</text></view><button class="delivery-switch" bindtap="toPickup">切换到店自取</button></view>
  <view class="delivery-address section" bindtap="toAddresses"><text class="address-pin">⌖</text><view><text class="product-name">送至：{{address?(address.contactName+' · '+address.detail):'请选择收货地址'}}</text><text class="subtitle">{{addressHint}}</text></view><text class="address-arrow">›</text></view>
  <view class="method-card section"><view class="delivery-methods"><button class="delivery-method {{method==='local'?'active':''}}" data-method="local" bindtap="selectMethod">同城外卖</button><button class="delivery-method {{method==='shipping'?'active':''}}" data-method="shipping" bindtap="selectMethod">快递邮寄</button></view><text class="subtitle">保温包装费 ¥2.00 · {{feeMessage}}</text></view>
  <view class="delivery-product-grid section"><block wx:for="{{products}}" wx:key="id"><view class="delivery-product-card" data-id="{{item.id}}" bindtap="goDetail"><view class="art delivery-product-art {{item.artClass}}"></view><text class="product-name">{{item.name}}</text><text class="subtitle">{{item.desc}}</text><view class="delivery-product-foot"><text class="price">{{item.priceText}}</text><view class="stepper" catchtap="stop"><button data-id="{{item.id}}" catchtap="decrease">−</button><text>{{item.quantity}}</text><button data-id="{{item.id}}" catchtap="increase">+</button></view></view></view></block></view>
  <view class="bar" bindtap="toCart"><view class="bar-content"><view class="bar-copy"><text class="delivery-cart-count">配送购物车 · {{cartCount}} 件</text><text wx:if="{{cartCount}}" class="price">{{cartSubtotal}}</text><text wx:else>包装费和{{transportLabel}}以结算页为准</text></view><button class="btn">去购物车</button></view></view>
</view>
