@import '../../app.wxss';
.detail-art{height:402rpx;border-radius:34rpx}.detail-art::before{width:63%;height:42%;top:28%;left:19%}.fresh-stamp{position:absolute;top:22rpx;left:22rpx;padding:10rpx 15rpx;border-radius:999rpx;background:rgba(255,252,244,.84);color:#b85e6d;font-size:22rpx;font-weight:700}.art-note{position:absolute;right:22rpx;bottom:20rpx;color:#80555d;font-size:18rpx;letter-spacing:2rpx}.detail-name-row{display:flex;align-items:end;justify-content:space-between;gap:15rpx;margin:19rpx 0}.detail-name-row .title{font-size:52rpx}.sales{color:#718083;font-size:21rpx;white-space:nowrap}.detail-copy{display:block;color:#596d70;font-size:26rpx;line-height:1.65}.detail-price-row{display:flex;align-items:center;gap:18rpx;margin-top:19rpx}.detail-price-row .price{font-size:42rpx}.reference-price{color:#718083;font-size:23rpx;text-decoration:line-through}.flavor-list{display:flex;gap:12rpx;overflow:hidden}.flavor-list text{flex:none;padding:11rpx 17rpx;border-radius:999rpx;background:#e7f3f8;color:#607478;font-size:22rpx}.spec-list{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:22rpx}.spec{margin:0;padding:18rpx 22rpx;border:2rpx solid #c7dce5;border-radius:20rpx;background:#fffcf4;color:#596d70;font-size:25rpx}.spec.active{border-color:#ffbcbd;background:#ffe0e6;color:#80555d;font-weight:700}.spec text{font-size:20rpx}.detail-action{padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom))}.detail-action-inner{display:flex;align-items:center;gap:12rpx}.cart-entry{position:relative;min-width:80rpx;height:80rpx;margin:0;padding:0;border:0;border-radius:24rpx;background:#e7f3f8;color:#596d70;font-size:20rpx}.cart-entry text{position:absolute;right:-7rpx;top:-8rpx;display:flex;align-items:center;justify-content:center;min-width:30rpx;height:30rpx;border-radius:50%;background:#ffbcbd;color:#344e50;font-size:18rpx}.detail-action .stepper{flex:none}.add-button{flex:1;min-width:0;min-height:80rpx;padding:0 12rpx;font-size:24rpx}
