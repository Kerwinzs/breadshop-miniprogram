<view class="page fixed-space"><view class="page-heading"><text class="title">自取订单详情</text><button class="text-button back-button" bindtap="back">返回</button></view><view wx:if="{{order}}"><view class="hero"><text class="pill">到店自取</text><view class="title" style="font-size:46rpx;margin-top:18rpx">{{order.orderStatus}}</view><text class="subtitle">{{order.store.name}} · {{order.store.address}}</text><text class="subtitle">营业时间 {{order.store.businessHours}}</text></view><view class="card section"><view class="row"><text class="product-name">支付状态</text><text>{{order.paymentLabel}}</text></view><view class="row"><text>应付金额</text><text class="price">{{order.payableAmount}}</text></view><text wx:if="{{order.canPay}}" class="subtitle">请在订单生成后15分钟内支付。</text><text wx:if="{{order.paymentExpired}}" class="subtitle">支付时限已过，订单已关闭或正在关闭。</text></view><view class="card section"><text class="product-name">商品明细</text><view class="row" wx:for="{{order.items}}" wx:key="productId"><text>{{item.name}} · {{item.specName}} × {{item.quantity}}</text><text>{{item.lineTotal}}</text></view><view class="row"><text>商品小计</text><text>{{order.total}}</text></view><view class="row"><text>合计</text><text class="price">{{order.total}}</text></view></view><view class="card section"><text class="subtitle">订单号 {{order.id}}</text><text class="subtitle">下单时间 {{order.createdAt}}</text></view><button wx:if="{{order.canPay}}" class="btn section" loading="{{paying}}" bindtap="pay">立即支付 · {{order.payableAmount}}</button><button wx:if="{{order.paymentStatus==='pending'}}" class="btn secondary section" loading="{{checkingPayment}}" bindtap="checkPayment">查询支付结果</button><button wx:if="{{canCancel}}" class="btn secondary section" bindtap="cancel">取消订单</button><button wx:if="{{canReorder}}" class="btn section" bindtap="reorder">再来一单</button></view><view wx:else class="notice">未找到该订单。</view></view>
